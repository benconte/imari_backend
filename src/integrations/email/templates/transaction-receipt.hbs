<!DOCTYPE html>
<html>
<body style="font-family:sans-serif;background:#f5f7fa;padding:40px 0;margin:0">
  <div style="max-width:520px;margin:auto;background:#fff;border-radius:12px;padding:40px;box-shadow:0 2px 8px rgba(0,0,0,.08)">
    <h2 style="color:#111;margin-top:0">{{title}}</h2>
    <p style="color:#444">Hi {{firstName}},</p>
    <p style="color:#444">{{body}}</p>

    <div style="background:#f8fafc;border-radius:8px;padding:20px;margin:24px 0">
      <table style="width:100%;border-collapse:collapse">
        <tr>
          <td style="color:#888;font-size:13px;padding:6px 0">Reference</td>
          <td style="color:#111;font-size:13px;text-align:right;font-family:monospace">{{reference}}</td>
        </tr>
        <tr>
          <td style="color:#888;font-size:13px;padding:6px 0">Amount</td>
          <td style="color:#111;font-size:18px;font-weight:700;text-align:right">{{currency}} {{amount}}</td>
        </tr>
        <tr>
          <td style="color:#888;font-size:13px;padding:6px 0">Type</td>
          <td style="color:#111;font-size:13px;text-align:right">{{type}}</td>
        </tr>
        {{#if counterparty}}
        <tr>
          <td style="color:#888;font-size:13px;padding:6px 0">{{counterpartyLabel}}</td>
          <td style="color:#111;font-size:13px;text-align:right">{{counterparty}}</td>
        </tr>
        {{/if}}
        <tr>
          <td style="color:#888;font-size:13px;padding:6px 0">Date</td>
          <td style="color:#111;font-size:13px;text-align:right">{{processedAt}}</td>
        </tr>
      </table>
    </div>

    <p style="color:#888;font-size:13px">If you did not authorise this transaction, contact support immediately.</p>
    <hr style="border:none;border-top:1px solid #eee;margin:24px 0">
    <p style="color:#bbb;font-size:12px;text-align:center">Imari — Intelligent Digital Banking</p>
  </div>
</body>
</html>
